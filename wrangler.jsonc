{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "aflekkas.com", "custom_domain": true },
    { "pattern": "www.aflekkas.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
