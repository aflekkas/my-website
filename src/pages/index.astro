---
import "@fontsource-variable/inter";
import "../styles/global.css";

import { Image } from "astro:assets";

import Card from "../components/Card.astro";

import portrait from "../assets/alexandros-lekkas.webp";
import linkedinLogo from "../assets/logos/linkedin.png";

import spawnPartners from "../assets/previews/spawn-partners.jpg";
import mediamaxxing from "../assets/previews/mediamaxxing.jpg";
import whiteDovecote from "../assets/previews/white-dovecote.jpg";
import apoesthisis from "../assets/previews/apoesthisis.jpg";

// Add a public email here to show it beside the links. Leave empty to hide.
const email = "";

const building = [
  {
    name: "Spawn Partners",
    href: "https://spawnpartners.com",
    description: "Technology partner for provider businesses.",
    preview: spawnPartners,
  },
];

const exited = [
  {
    name: "MediaMaxxing",
    href: "https://www.mediamaxxing.com",
    description: "Creator-first platform connecting brands with creators.",
    preview: mediamaxxing,
  },
];

const sites = [
  {
    name: "White Dovecote",
    href: "https://whitedovecote.com",
    description: "Private villa in Agapi, Tinos.",
    preview: whiteDovecote,
  },
  {
    name: "Apoesthisis",
    href: "https://apoesthisis.com",
    description: "Creative practice working in ceramics and mixed media.",
    preview: apoesthisis,
  },
];

const title = "Alexandros Lekkas";
const description = "My personal website.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={Astro.site} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <main class="min-h-screen bg-background">
      <div class="mx-auto max-w-2xl px-6 py-16 sm:py-20">
        <div class="flex items-start gap-x-5">
          <Image
            data-animate
            style="--stagger: 0"
            src={portrait}
            alt="Alexandros Lekkas"
            width={96}
            densities={[1, 2, 3]}
            class="size-16 shrink-0 rounded-md object-cover sm:size-20"
          />

          <div>
            <div data-animate style="--stagger: 1" class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <h1 class="font-medium">Alexandros Lekkas</h1>

              <div class="flex items-center gap-2">
                <a
                  href="https://github.com/aflekkas"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="GitHub"
                  title="GitHub"
                  class="inline-flex"
                >
                  {/* GitHub Invertocat, from the official logo pack at github.com/logos. */}
                  <svg
                    viewBox="0 0 98 96"
                    fill="none"
                    aria-hidden="true"
                    class="size-5 shrink-0 opacity-80 transition-opacity duration-150 hover:opacity-100"
                  >
                    <path
                      d="M41.4395 69.3848C28.8066 67.8535 19.9062 58.7617 19.9062 46.9902C19.9062 42.2051 21.6289 37.0371 24.5 33.5918C23.2559 30.4336 23.4473 23.7344 24.8828 20.959C28.7109 20.4805 33.8789 22.4902 36.9414 25.2656C40.5781 24.1172 44.4062 23.543 49.0957 23.543C53.7852 23.543 57.6133 24.1172 61.0586 25.1699C64.0254 22.4902 69.2891 20.4805 73.1172 20.959C74.457 23.543 74.6484 30.2422 73.4043 33.4961C76.4668 37.1328 78.0937 42.0137 78.0937 46.9902C78.0937 58.7617 69.1934 67.6621 56.3691 69.2891C59.623 71.3945 61.8242 75.9883 61.8242 81.252L61.8242 91.2051C61.8242 94.0762 64.2168 95.7031 67.0879 94.5547C84.4102 87.9512 98 70.6289 98 49.1914C98 22.1074 75.9883 6.69539e-07 48.9043 4.309e-07C21.8203 1.92261e-07 -1.9479e-07 22.1074 -4.3343e-07 49.1914C-6.20631e-07 70.4375 13.4941 88.0469 31.6777 94.6504C34.2617 95.6074 36.75 93.8848 36.75 91.3008L36.75 83.6445C35.4102 84.2188 33.6875 84.6016 32.1562 84.6016C25.8398 84.6016 22.1074 81.1563 19.4277 74.7441C18.375 72.1602 17.2266 70.6289 15.0254 70.3418C13.877 70.2461 13.4941 69.7676 13.4941 69.1934C13.4941 68.0449 15.4082 67.1836 17.3223 67.1836C20.0977 67.1836 22.4902 68.9063 24.9785 72.4473C26.8926 75.2227 28.9023 76.4668 31.2949 76.4668C33.6875 76.4668 35.2187 75.6055 37.4199 73.4043C39.0469 71.7773 40.291 70.3418 41.4395 69.3848Z"
                      fill="black"></path>
                  </svg>
                </a>

                <a
                  href="https://www.linkedin.com/in/alexandros-lekkas/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="LinkedIn"
                  title="LinkedIn"
                  class="inline-flex"
                >
                  {/* The In bug, from the official logo pack at brand.linkedin.com/downloads. */}
                  <Image
                    src={linkedinLogo}
                    alt=""
                    width={20}
                    densities={[1, 2, 3]}
                    class="size-5 shrink-0 object-contain opacity-80 transition-opacity duration-150 hover:opacity-100"
                  />
                </a>

                {
                  email && (
                    <a href={`mailto:${email}`} aria-label="Email" title="Email" class="inline-flex">
                      <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                        class="size-5 shrink-0 p-0.5 text-muted-foreground transition-colors duration-150 hover:text-foreground"
                      >
                        <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                        <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
                      </svg>
                    </a>
                  )
                }
              </div>
            </div>

            <p data-animate style="--stagger: 2" class="mt-2 text-muted-foreground">
              Computer Science at the University of Chicago. I build{" "}
              <a
                href="https://spawnpartners.com"
                target="_blank"
                rel="noopener noreferrer"
                class="underline-offset-4 hover:underline">Spawn Partners</a
              > and websites for clients.
            </p>
          </div>
        </div>

        <div data-animate style="--stagger: 3" class="mt-16 grid gap-x-6 gap-y-8 sm:grid-cols-2">
          <div class="flex flex-col gap-3">
            <h2 class="text-sm font-normal text-muted-foreground">Building</h2>
            {building.map((item) => <Card {...item} />)}
          </div>

          <div class="flex flex-col gap-3">
            <h2 class="text-sm font-normal text-muted-foreground">Exited</h2>
            {exited.map((item) => <Card {...item} />)}
          </div>
        </div>

        <div data-animate style="--stagger: 4" class="mt-12 flex flex-col gap-3">
          <h2 class="text-sm font-normal text-muted-foreground">Sites</h2>

          <div class="grid gap-6 sm:grid-cols-2">
            {sites.map((item) => <Card {...item} />)}
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
