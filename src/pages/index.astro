---
import "@fontsource-variable/inter";
import "../styles/global.css";

import Card from "../components/Card.astro";

import spawnPartners from "../assets/previews/spawn-partners.jpg";
import mediamaxxing from "../assets/previews/mediamaxxing.jpg";
import whiteDovecote from "../assets/previews/white-dovecote.jpg";
import apoesthisis from "../assets/previews/apoesthisis.jpg";

// Add a public email here to show it in the Connect line. Leave empty to hide.
const email = "";

const building = [
  {
    name: "Spawn Partners",
    href: "https://spawnpartners.com",
    description: "Technology partner for provider businesses.",
    preview: spawnPartners,
  },
];

const exited = [
  {
    name: "MediaMaxxing",
    href: "https://www.mediamaxxing.com",
    description: "Creator-first platform connecting brands with creators.",
    preview: mediamaxxing,
  },
];

const sites = [
  {
    name: "White Dovecote",
    href: "https://whitedovecote.com",
    description: "Private villa in Agapi, Tinos.",
    preview: whiteDovecote,
  },
  {
    name: "Apoesthisis",
    href: "https://apoesthisis.com",
    description: "Creative practice working in ceramics and mixed media.",
    preview: apoesthisis,
  },
];

const title = "Alexandros Lekkas";
const description = "My personal website.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={Astro.site} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <main class="min-h-screen bg-background">
      <div class="mx-auto max-w-2xl px-6 py-16 sm:py-20">
        <h1 data-animate style="--stagger: 0" class="font-medium">Alexandros Lekkas</h1>

        <p data-animate style="--stagger: 1" class="mt-4 text-muted-foreground">
          Computer Science at the University of Chicago. I build{" "}
          <a
            href="https://spawnpartners.com"
            target="_blank"
            rel="noopener noreferrer"
            class="underline-offset-4 hover:underline">Spawn Partners</a
          >, software that audits how AI assistants describe healthcare practices, mostly for
          multi-location dental groups across the US. I also build websites for clients.
        </p>

        <div data-animate style="--stagger: 3" class="mt-16 grid gap-x-6 gap-y-8 sm:grid-cols-2">
          <div class="flex flex-col gap-3">
            <h2 class="text-sm font-normal text-muted-foreground">Building</h2>
            {building.map((item) => <Card {...item} />)}
          </div>

          <div class="flex flex-col gap-3">
            <h2 class="text-sm font-normal text-muted-foreground">Exited</h2>
            {exited.map((item) => <Card {...item} />)}
          </div>
        </div>

        <div data-animate style="--stagger: 4" class="mt-12 flex flex-col gap-3">
          <h2 class="text-sm font-normal text-muted-foreground">Sites</h2>

          <div class="grid gap-6 sm:grid-cols-2">
            {sites.map((item) => <Card {...item} />)}
          </div>
        </div>

        <div data-animate style="--stagger: 5" class="mt-16">
          <h2 class="font-medium">Connect</h2>

          <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3">
            <a
              href="https://github.com/aflekkas"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2"
            >
              <span
                class="flex size-6 items-center justify-center rounded-md bg-[#181717] text-white shadow-sm transition-transform duration-200 group-hover:-translate-y-0.5"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-3.5">
                  <path
                    d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                  ></path>
                </svg>
              </span>

              <span
                class="text-sm text-muted-foreground underline-offset-4 transition-colors group-hover:text-foreground group-hover:underline"
              >
                GitHub
              </span>
            </a>

            <a
              href="https://www.linkedin.com/in/alexandros-lekkas/"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2"
            >
              <span
                class="flex size-6 items-center justify-center rounded-md bg-[#0A66C2] text-white shadow-sm transition-transform duration-200 group-hover:-translate-y-0.5"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-3.5">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                  ></path>
                  <rect width="4" height="12" x="2" y="9" rx="0.5"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </span>

              <span
                class="text-sm text-muted-foreground underline-offset-4 transition-colors group-hover:text-foreground group-hover:underline"
              >
                LinkedIn
              </span>
            </a>

            {
              email && (
                <a href={`mailto:${email}`} class="group inline-flex items-center gap-2">
                  <span class="flex size-6 items-center justify-center rounded-md bg-neutral-500 text-white shadow-sm transition-transform duration-200 group-hover:-translate-y-0.5">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-3.5">
                      <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                      <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
                    </svg>
                  </span>

                  <span class="text-sm text-muted-foreground underline-offset-4 transition-colors group-hover:text-foreground group-hover:underline">
                    Email
                  </span>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
